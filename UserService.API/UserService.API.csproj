<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="MediatR" Version="14.3.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
      <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
      <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.3.1" />
      <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.1" />
      <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\UserService.Application\UserService.Application.csproj" />
      <ProjectReference Include="..\UserService.Infrastructure\UserService.Infrastructure.csproj" />
    </ItemGroup>

</Project>
